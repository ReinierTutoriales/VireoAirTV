+    if (req[4] == 0x02 && fp->version == 2 && fp->v2) {
+        return fairplay_v2_handshake(fp->v2, req, res);
+    }
     if (req[4] != 0x03 || req[12] >= 4) {
-        /* Unsupported fairplay version or mode */
