     assert(fp);
 
-    /* req[14] (the key mode, from the network) indexes reply_message[4] */
+    fairplay_reset(fp);
+    if (req[4] == 0x02) {
+        fp->v2 = fairplay_v2_init();
+        if (!fp->v2) {
+            return FAIRPLAY_V2_NOMEM;
+        }
+        int ret = fairplay_v2_setup(fp->v2, req, res);
+        if (ret != FAIRPLAY_V2_OK) {
+            fairplay_reset(fp);
+            return ret;
+        }
+        fp->version = 2;
+        return 0;
+    }
+
