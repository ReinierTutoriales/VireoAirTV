     }
 
+    /* Keep accepting the v3 handshake independently of the setup request,
+     * as the original PlayFair implementation did. */
+    fairplay_reset(fp);
+    fp->version = 3;
+
     memcpy(fp->keymsg, req, 164);
     fp->keymsglen = 164;
 
