 int
 fairplay_decrypt(fairplay_t *fp, const unsigned char input[72], unsigned char output[16])
 {
-    if (fp->keymsglen != 164) {
+    assert(fp);
+
+    memset(output, 0, 16);
+    if (fp->version == 2 && fp->v2) {
+        return fairplay_v2_decrypt_key(fp->v2, input, output);
+    }
+
+    if (fp->version != 3 || fp->keymsglen != 164) {
         return -1;
     }
 
@@ -96,5 +138,8 @@ fairplay_decrypt(fairplay_t *fp, const unsigned char input[72], unsigned char ou
 void
 fairplay_destroy(fairplay_t *fp)
 {
+    if (fp) {
+        fairplay_reset(fp);
+    }
     free(fp);
 }
