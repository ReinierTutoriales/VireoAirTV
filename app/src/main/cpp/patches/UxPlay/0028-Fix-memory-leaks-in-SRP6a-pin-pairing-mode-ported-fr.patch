From ddc1847421c94cf8c12ba0850c9ec6ab43cee148 Mon Sep 17 00:00:00 2001
From: ReinierTutoriales <86568548+ReinierTutoriales@users.noreply.github.com>
Date: Wed, 18 Nov 2026 05:11:12 -0500
Subject: [PATCH 28/29] Fix memory leaks in SRP6a pin-pairing mode (ported from
 upstream 60e6430)

Kept our 7-argument srp_validate_proof signature. Corrected two
upstream defects in the SETUP size check: the ekey_len debug log passed
an int to %llu, and the error log passed freed pointers to "&d,%d".
Free the request/response plists on the new 400 path.
---
 lib/crypto.c        |  3 +-
 lib/http_request.c  |  4 +-
 lib/pairing.c       |  5 ++-
 lib/pairing.h       |  4 +-
 lib/raop_handlers.h | 91 ++++++++++++++++++++++++++++-----------------
 lib/srp.c           |  7 ++--
 uxplay.cpp          |  1 +
 7 files changed, 70 insertions(+), 45 deletions(-)

diff --git a/lib/crypto.c b/lib/crypto.c
index 762c648..ebea704 100644
--- a/lib/crypto.c
+++ b/lib/crypto.c
@@ -619,8 +619,7 @@ void pk_to_base64(const unsigned char *pk, int pk_len, char *pk_base64, int len)
     BIO_flush(bio);
 
     BIO_get_mem_ptr(bio, &bufferPtr);
-    BIO_set_close(bio, BIO_NOCLOSE);
-    BIO_free_all(bio);
     memcpy(pk_base64,(*bufferPtr).data, len64);
+    BIO_free_all(bio);
 }
   
diff --git a/lib/http_request.c b/lib/http_request.c
