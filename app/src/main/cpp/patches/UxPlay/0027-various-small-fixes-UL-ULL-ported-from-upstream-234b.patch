Subject: [PATCH 27/29] various small fixes UL -> ULL (ported from upstream
 234b407)

---
 lib/byteutils.c       | 2 +-
 lib/raop_ntp.c        | 2 +-
 lib/raop_rtp_mirror.c | 2 +-
 lib/utils.c           | 6 +++---
 4 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/lib/byteutils.c b/lib/byteutils.c
index 158f4e4..fab7128 100644
--- a/lib/byteutils.c
+++ b/lib/byteutils.c
@@ -16,7 +16,7 @@
  */
  
 
-#define SECOND_IN_NSECS 1000000000UL
+#define SECOND_IN_NSECS 1000000000ULL
 
 #include <time.h>
 #include <string.h>
diff --git a/lib/raop_ntp.c b/lib/raop_ntp.c
index 7da009d..8154137 100644
--- a/lib/raop_ntp.c
+++ b/lib/raop_ntp.c
@@ -37,7 +37,7 @@
 #include "byteutils.h"
 #include "utils.h"
 
-#define SECOND_IN_NSECS 1000000000UL
+#define SECOND_IN_NSECS 1000000000ULL
 #define RAOP_NTP_DATA_COUNT   8
 #define RAOP_NTP_PHI_PPM   15ull                   // PPM
 #define RAOP_NTP_R_RHO   ((1ull    << 32) / 1000u) // packet precision
diff --git a/lib/raop_rtp_mirror.c b/lib/raop_rtp_mirror.c
index ebea51a..49fb0b9 100644
--- a/lib/raop_rtp_mirror.c
+++ b/lib/raop_rtp_mirror.c
@@ -51,7 +51,7 @@
 #define CAST
 #endif
 
-#define SECOND_IN_NSECS 1000000000UL
+#define SECOND_IN_NSECS 1000000000ULL
 #define SEC SECOND_IN_NSECS
 
 /* for MacOS, where SOL_TCP and TCP_KEEPIDLE are not defined */
diff --git a/lib/utils.c b/lib/utils.c
index ee7064a..be3ee3a 100644
--- a/lib/utils.c
+++ b/lib/utils.c
@@ -23,7 +23,7 @@
 #include <stdint.h>
 #include <limits.h>
 
-#define SECOND_IN_NSECS 1000000000UL
+#define SECOND_IN_NSECS 1000000000ULL
 
 char *
 utils_strsep(char **stringp, const char *delim)
@@ -239,7 +239,7 @@ void ntp_timestamp_to_time(uint64_t ntp_timestamp, char *timestamp, size_t maxsi
 #else
     strftime(timestamp, 20, "%F %T", &ts);
 #endif
-    snprintf(timestamp + 19, 11,".%9.9lu", (unsigned long) ntp_timestamp % SECOND_IN_NSECS);
+    snprintf(timestamp + 19, 11,".%9.9llu", (unsigned long long) ntp_timestamp % SECOND_IN_NSECS);
 }
 
 void ntp_timestamp_to_seconds(uint64_t ntp_timestamp, char *timestamp, size_t maxsize) {
@@ -247,7 +247,7 @@ void ntp_timestamp_to_seconds(uint64_t ntp_timestamp, char *timestamp, size_t ma
     struct tm ts = *localtime(&rawtime);
     assert(maxsize > 12);
     strftime(timestamp, 3, "%S", &ts);
-    snprintf(timestamp + 2, 11,".%9.9lu", (unsigned long) ntp_timestamp % SECOND_IN_NSECS);
+    snprintf(timestamp + 2, 11,".%9.9llu", (unsigned long long) ntp_timestamp % SECOND_IN_NSECS);
 }
 
