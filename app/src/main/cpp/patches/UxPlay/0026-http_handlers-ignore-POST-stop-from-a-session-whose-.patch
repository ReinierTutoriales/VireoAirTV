From 6542c17215834f8425ca248b82f6221f1ec893c5 Mon Sep 17 00:00:00 2001
From: p <p@p>
Date: Wed, 18 Nov 2026 05:08:46 -0500
Subject: [PATCH 26/29] http_handlers: ignore POST /stop from a session whose
 video was replaced

Ported from upstream PR #624 (not merged upstream yet). An iOS app that
replaces its video session with a new /play later sends POST /stop with
the X-Apple-Session-ID of the older session, which stopped the new video.
---
 lib/http_handlers.h | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/lib/http_handlers.h b/lib/http_handlers.h
index e98c19a..e53ca59 100644
--- a/lib/http_handlers.h
+++ b/lib/http_handlers.h
@@ -152,6 +152,16 @@ http_handler_stop(raop_conn_t *conn, http_request_t *request, http_response_t *r
     raop_t *raop = conn->raop;
     logger_log(raop->logger, LOGGER_INFO, "client HTTP request POST stop");
 
+    /* a /stop from an older (or parallel) session must not stop the video that a newer /play started */
+    const char *session_id = http_request_get_header(request, "X-Apple-Session-ID");
+    airplay_video_t *airplay_video = (raop->current_video >= 0 ? raop->airplay_video[raop->current_video] : NULL);
+    const char *apple_session_id = (airplay_video ? get_apple_session_id(airplay_video) : NULL);
+    if (session_id && apple_session_id && strcmp(session_id, apple_session_id)) {
+        logger_log(raop->logger, LOGGER_INFO, "POST /stop from session %s ignored: current video belongs to session %s",
+                   session_id, apple_session_id);
+        return;
+    }
+
     raop->video_play_conn = NULL;
     raop->callbacks.on_video_stop(raop->callbacks.cls);
 }
