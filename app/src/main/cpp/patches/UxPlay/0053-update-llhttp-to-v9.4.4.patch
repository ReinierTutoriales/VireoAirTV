From b3322ea7e62771242429b334c079a5292fb381d1 Mon Sep 17 00:00:00 2001
From: ReinierTutoriales <86568548+ReinierTutoriales@users.noreply.github.com>
Date: Wed, 18 Nov 2026 13:10:30 -0500
Subject: [PATCH] update llhttp to v9.4.4

Unmodified release/v9.4.4 sources from nodejs/llhttp, as upstream UxPlay did for 9.4.2 in 78537a4. Parser fixes since 9.3: CRLF required in the status line, tab after a Connection: close value, empty Transfer-Encoding rejected (9.4.3), relaxed header values back on the fast scanner (9.4.4).
---
 lib/llhttp/api.c    |   8 +
 lib/llhttp/llhttp.c | 991 ++++++++++++++++++++++++--------------------
 lib/llhttp/llhttp.h |  44 +-
 3 files changed, 582 insertions(+), 461 deletions(-)

diff --git a/lib/llhttp/api.c b/lib/llhttp/api.c
index 0245254..ae5e862 100644
--- a/lib/llhttp/api.c
+++ b/lib/llhttp/api.c
@@ -316,6 +316,14 @@ void llhttp_set_lenient_spaces_after_chunk_size(llhttp_t* parser, int enabled) {
   }
 }
 
+void llhttp_set_lenient_header_value_relaxed(llhttp_t* parser, int enabled) {
+  if (enabled) {
+    parser->lenient_flags |= LENIENT_HEADER_VALUE_RELAXED;
+  } else {
+    parser->lenient_flags &= ~LENIENT_HEADER_VALUE_RELAXED;
+  }
+}
+
 /* Callbacks */
 
 
